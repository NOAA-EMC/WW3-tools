#!/bin/sh
#SBATCH --nodes=1
#SBATCH --ntasks=32               # Number of tasks/cores
#SBATCH --ntasks-per-node=32
#SBATCH -q batch
#SBATCH -t 08:00:00
#SBATCH -A marine-cpu
#SBATCH -J ml_test
#SBATCH -o ml_test.out


# Load the MATLAB module
module load matlab/R2024b  # Specify the version you need

# Run your MATLAB script without a graphical interface
matlab -nodisplay -nodesktop -r "run('./GenGHHSMesh.m'); exit;"
